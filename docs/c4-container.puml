@startuml
title Авито.Кухня — C4 Container
skinparam componentStyle rectangle

actor "Пользователь" as user
actor "Сотрудник заведения" as staff
rectangle "Web-клиент\n[Container: browser]" as web
rectangle "Авито.Кухня API\n[Container: Go/Gin]" as api
database "PostgreSQL\n[Container: database]" as db
rectangle "Example Restaurant\n[Container: Go/Gin]" as restaurant

user --> web : выбирает блюда, следит за заказом
web --> api : JSON/HTTPS
api --> db : SQL/pgx
api --> restaurant : заказ, HTTP/JSON
restaurant --> api : статус заказа, HTTP/JSON
staff --> restaurant : подтверждает и готовит заказ

note bottom of api
  Каталог, заказы, status machine,
  идемпотентность и интеграция
end note
@enduml
