@startuml
title Авито.Кухня — C4 Container
skinparam componentStyle rectangle

actor "Пользователь" as user
rectangle "Web-клиент\n[Container: browser]" as web
rectangle "Авито.Кухня API\n[Container: Go/Gin]" as api
database "PostgreSQL\n[Container: database]" as db
rectangle "Restaurant Service\n[Container: Go/Gin]" as restaurant

user --> web : выбирает блюда, следит за заказом
web --> api : HTTP/JSON
api --> db : SQL/pgx
api --> restaurant : передаёт заказ, HTTP/JSON
restaurant --> api : синхронное решение accepted/rejected

note bottom of api
  Каталог, заказы, начальные статусы,
  идемпотентность и интеграция
end note
@enduml
